{
	"name": "obsidian-to-publish",
	"version": "0.1.6",
	"description": "Preview notes, copy platform-ready rich HTML/Markdown, and optionally publish via WeChat, Feishu, or Chrome companion.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"wechat",
		"zhishixingqiu",
		"markdown",
		"feishu",
		"publishing"
	],
	"author": "Next蔡蔡",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/nextcaicai/obsidian-to-publish.git"
	},
	"bugs": {
		"url": "https://github.com/nextcaicai/obsidian-to-publish/issues"
	},
	"homepage": "https://github.com/nextcaicai/obsidian-to-publish#readme",
	"devDependencies": {
		"@types/node": "^22.15.30",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.25.5",
		"obsidian": "^1.8.7",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}
