{
	"manifest_version": 3,
	"name": "Obsidian to Publish Companion",
	"version": "0.1.0",
	"description": "Receives Obsidian to Publish draft packages and helps import them into browser editors.",
	"permissions": [
		"clipboardWrite",
		"storage",
		"tabs",
		"windows"
	],
	"host_permissions": [
		"ws://127.0.0.1:*/*",
		"https://x.com/*",
		"https://twitter.com/*",
		"https://editor.csdn.net/*",
		"https://juejin.cn/*",
		"https://www.zhihu.com/*",
		"https://zhuanlan.zhihu.com/*",
		"https://substack.com/*",
		"https://*.substack.com/*",
		"https://creator.xiaohongshu.com/*",
		"https://member.bilibili.com/*",
		"https://wx.zsxq.com/*"
	],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://x.com/*",
				"https://twitter.com/*",
				"https://editor.csdn.net/*",
				"https://juejin.cn/*",
				"https://www.zhihu.com/*",
				"https://zhuanlan.zhihu.com/*",
				"https://substack.com/*",
				"https://*.substack.com/*",
				"https://creator.xiaohongshu.com/*",
				"https://member.bilibili.com/*",
				"https://wx.zsxq.com/*"
			],
			"js": [
				"src/assets/publish-assets.js",
				"src/content-shared.js",
				"src/platforms/x.js",
				"src/platforms/csdn.js",
				"src/platforms/juejin.js",
				"src/platforms/zhihu.js",
				"src/platforms/substack.js",
				"src/platforms/misc.js",
				"src/content.js"
			],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"src/page-x-upload.js"
			],
			"matches": [
				"https://x.com/*",
				"https://twitter.com/*"
			]
		},
		{
			"resources": [
				"src/page-juejin-upload.js"
			],
			"matches": [
				"https://juejin.cn/*"
			]
		},
		{
			"resources": [
				"src/page-csdn-upload.js"
			],
			"matches": [
				"https://editor.csdn.net/*"
			]
		}
	],
	"options_page": "options.html",
	"action": {
		"default_title": "Obsidian to Publish Companion"
	}
}
